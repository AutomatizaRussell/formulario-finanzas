server {
    listen 80;
    server_name _;
    client_max_body_size 50M;

    root /usr/share/nginx/html;
    index index.html;

    location = /healthz {
        access_log off;
        return 200 'ok';
    }

    # Archivos generados por Vite llevan hash en el nombre: cache largo
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        # DNS interno de Docker; resolver en cada petición evita fallar si el backend arranca después
        resolver 127.0.0.11 valid=30s;
        set $api_upstream http://${API_UPSTREAM};

        # Sin URI en proxy_pass: se reenvía la ruta original (/api/enviar-formulario)
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
