        "jsCode": "// ===== CONFIGURACIÓN (cambiar aquí) =====\nconst CONFIG = {\n  DRIVE_ID: 'b!A_gs-UIBkkSRY-pKFZcuyNi87qYccLlJvZ-a5Y4rRAFv9vyPEXIXQZnRz1y4Vgw4',\n  RUTA_CARPETA_RAIZ: 'Documentación 2026/2. CLIENTES/PRECIOS TRANSFERFENCIA',\n  RUTA_EXCEL: 'Documentación 2026/2. CLIENTES/PRECIOS TRANSFERFENCIA/INFORMACION-FORMULARIO-PT.xlsx',\n  TABLA_EXCEL: 'DATA',\n};\n// Pasa los datos del formulario y los archivos tal cual al siguiente nodo\nconst item = $input.first();\nreturn [{ json: { ...CONFIG, body: item.json.body || {} }, binary: item.binary || {} }];"
