    {
      "parameters": {
        "jsCode": "// Arma la fila para la tabla del Excel en SharePoint.\n// El ORDEN debe coincidir exactamente con las columnas de la tabla.\nconst d = $('INFORMACION').first().json;\nconst carpeta = $input.first().json;\nconst binarios = $('CONFIGURACION').first().binary || {};\nconst cantidadArchivos = Object.keys(binarios).filter(k => k.startsWith('soporte_financiero')).length;\n\nconst texto = (v) => {\n  const t = String(v ?? '').trim();\n  return /^[=+\\-@]/.test(t) ? \"'\" + t : t; // evita que Excel lo interprete como fórmula\n};\nconst legible = (v) => texto(String(v ?? '').replace(/_/g, ' '));\n\nconst fila = [\n  String($execution.id),          // ID SOLICITUD\n  d.FECHA_ENVIO,                  // FECHA ENVÍO\n  texto(d.RAZON_SOCIAL),          // RAZÓN SOCIAL\n  texto(d.NIT),                   // NIT RAZÓN SOCIAL\n  legible(d.SECTOR),              // SECTOR AL QUE PERTENECE\n  texto(d.ZONA_FRANCA),           // ¿POSEE VINCULADOS EN ZONA FRANCA?\n  texto(d.VINCULACION_EXTERIOR),  // ¿POSEE VINCULADOS EN EL EXTERIOR?\n  legible(d.SENIOR_CARGO),        // SENIOR A CARGO\n  texto(d.VINCULADOS_RAZON_SOCIAL), // RAZÓN SOCIAL DE LOS VINCULADOS\n  texto(d.DETALLE_SERVICIOS),     // VENTA DE BIENES O PRESTACIÓN DE SERVICIOS\n  texto(d.DETALLE_PRESTAMOS),     // SALDOS O MOVIMIENTOS DE PRÉSTAMOS\n  texto(d.PAISES_NO_COOPERANTES), // OPERACIONES EN JURISDICCIONES NO COOPERANTES\n  cantidadArchivos,               // CANTIDAD DE ARCHIVOS\n  carpeta.webUrl || '',           // CARPETA SHAREPOINT\n];\nreturn [{ json: { fila } }];"
      },
      "type": "n8n-nodes-base.code",
