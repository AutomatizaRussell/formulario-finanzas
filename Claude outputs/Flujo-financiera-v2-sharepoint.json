    {
      "parameters": {
        "jsCode": "// Toma los archivos del webhook (soporte_financiero o soporte_financiero_0, _1, ...)\n// y genera un item por archivo con el ID de la carpeta recién creada.\nconst binarios = $('CONFIGURACION').first().binary || {};\nconst carpeta = $input.first().json;\n\n// Corrige nombres que llegan con tildes mal codificadas (p. ej. \"SUBÃREA\" -> \"SUBÁREA\")\nconst arreglarNombre = (nombre) => {\n  let n = String(nombre || 'archivo.xlsx');\n  if (/[ÃÂ]/.test(n)) {\n    try { n = Buffer.from(n, 'latin1').toString('utf8'); } catch (e) {}\n  }\n  return n.replace(/[\\\\/:*?\"<>|#%]/g, '').trim();\n};\n\nconst items = [];\nfor (const key of Object.keys(binarios).sort()) {\n  if (!key.startsWith('soporte_financiero')) continue;\n  const archivo = { ...binarios[key] };\n  archivo.fileName = arreglarNombre(archivo.fileName);\n  items.push({\n    json: { carpetaId: carpeta.id, carpetaUrl: carpeta.webUrl, archivo: archivo.fileName },\n    binary: { archivo_actual: archivo },\n  });\n}\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        112
      ],
      "id": "67eb4127-18bb-454e-9d88-9be7ba303dbf",
      "name": "PREPARAR ARCHIVOS"
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://graph.microsoft.com/v1.0/drives/{{ $('INFORMACION').first().json.DRIVE_ID }}/items/{{ $json.carpetaId }}:/{{ encodeURIComponent($binary.archivo_actual.fileName) }}:/content?@microsoft.graph.conflictBehavior=rename",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftOneDriveOAuth2Api",
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "archivo_actual",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
