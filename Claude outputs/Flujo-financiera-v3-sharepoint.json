    {
      "parameters": {
        "jsCode": "// Junta las filas existentes del Excel con la fila nueva.\n// HEADERS debe coincidir con los encabezados de la fila 1 del Excel.\nconst HEADERS = [\n  'ID SOLICITUD', 'FECHA ENVÍO', 'RAZÓN SOCIAL', 'NIT RAZÓN SOCIAL', 'SECTOR AL QUE PERTENECE',\n  '¿POSEE VINCULADOS EN ZONA FRANCA?', '¿POSEE VINCULADOS EN EL EXTERIOR?', 'SENIOR A CARGO',\n  'RAZÓN SOCIAL DE LOS VINCULADOS',\n  'VENTA DE BIENES O PRESTACIÓN DE SERVICIOS CON LA MATRIZ O VINCULADOS',\n  'SALDOS O MOVIMIENTOS DE PRÉSTAMOS VIGENTES CON VINCULADOS',\n  'OPERACIONES EN JURISDICCIONES NO COOPERANTES O DE BAJA IMPOSICIÓN',\n  'CANTIDAD DE ARCHIVOS', 'CARPETA SHAREPOINT',\n];\nconst aObjeto = (valores) => Object.fromEntries(HEADERS.map((h, i) => [h, valores[i] ?? '']));\n\nconst existentes = $input.all()\n  .map(i => i.json)\n  .filter(r => Object.values(r).some(v => String(v ?? '').trim() !== '')) // quita filas vacías\n  .map(r => aObjeto(HEADERS.map(h => r[h])));\n\nconst nueva = aObjeto($('ARMAR FILA EXCEL').first().json.fila);\nreturn [...existentes, nueva].map(json => ({ json }));"
      },
